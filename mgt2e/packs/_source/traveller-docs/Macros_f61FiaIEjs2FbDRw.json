        "lastModifiedBy": "mhUjqDVicnwIUaiq"
      },
      "_key": "!journal.pages!f61FiaIEjs2FbDRw.qQCaa2kkDIPohHIO"
    },
    {
      "sort": 600000,
      "name": "Cover",
      "type": "text",
      "_id": "jw2PzBpt6TMHYchL",
      "system": {},
      "title": {
        "show": true,
        "level": 1
      },
      "image": {},
      "text": {
        "format": 1,
        "content": "<p>Adds a cover or hiding effect to an actor. Hiding gives an actor extra protection, cover makes them harder to hit. The drop down menu provides common values as per the Mongoose 2e rules.</p><p>@UUID[Compendium.mgt2e.base-macros.Macro.LBniQ3L4iJ0YfcMT]{Cover}</p>"
